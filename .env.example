# ============================================================
# Trustworthy Skin Cancer AI Platform — Environment Variables
# Copy to .env and fill in the required values.
# NEVER commit .env to version control.
# ============================================================

# ────────────────────────────────────────────────────────────
# Application
# ────────────────────────────────────────────────────────────
APP_ENV=development           # development | staging | production
DEBUG=false
LOG_LEVEL=INFO

# ────────────────────────────────────────────────────────────
# Security — GENERATE STRONG VALUES IN PRODUCTION
# python -c "import secrets; print(secrets.token_hex(32))"
# ────────────────────────────────────────────────────────────
SECRET_KEY=change-me-to-a-strong-random-secret-key
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ────────────────────────────────────────────────────────────
# PostgreSQL
# ────────────────────────────────────────────────────────────
POSTGRES_USER=skinai
POSTGRES_PASSWORD=your-strong-db-password
POSTGRES_DB=skin_cancer_ai
DATABASE_URL=postgresql+asyncpg://skinai:your-strong-db-password@localhost:5432/skin_cancer_ai

# ────────────────────────────────────────────────────────────
# Redis
# ────────────────────────────────────────────────────────────
REDIS_PASSWORD=your-redis-password
REDIS_URL=redis://:your-redis-password@localhost:6379/0

# ────────────────────────────────────────────────────────────
# MLflow
# ────────────────────────────────────────────────────────────
MLFLOW_TRACKING_URI=http://localhost:5000

# ────────────────────────────────────────────────────────────
# Weights & Biases (optional)
# ────────────────────────────────────────────────────────────
WANDB_API_KEY=your-wandb-api-key
WANDB_PROJECT=trustworthy-skin-cancer-ai
WANDB_ENTITY=your-wandb-username

# ────────────────────────────────────────────────────────────
# Model Settings
# ────────────────────────────────────────────────────────────
MODEL_REGISTRY_PATH=./models
ACTIVE_CLASSIFIER=efficientnet_b4
CONFIDENCE_THRESHOLD=0.70
OOD_THRESHOLD=0.50
DEVICE=cuda    # cuda | cpu

# ────────────────────────────────────────────────────────────
# Storage
# ────────────────────────────────────────────────────────────
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=20

# ────────────────────────────────────────────────────────────
# CORS
# ────────────────────────────────────────────────────────────
CORS_ORIGINS=["http://localhost:3000"]

# ────────────────────────────────────────────────────────────
# Monitoring
# ────────────────────────────────────────────────────────────
GRAFANA_PASSWORD=admin
