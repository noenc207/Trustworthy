# Trustworthy Medical AI — .gitignore
# ===================================

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
dist/
build/
*.egg

# Virtual environments
venv/
env/
.venv/

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# Jupyter
.ipynb_checkpoints/

# Data (too large for git)
data/
*.zip
*.tar.gz
*.h5
*.hdf5

# Model weights and checkpoints
checkpoints/
checkpoints_v2/
*.pt
*.pth
*.onnx
*.torchscript

# Logs
logs/
*.log
mlruns/
wandb/
outputs/
multirun/

# OS
.DS_Store
Thumbs.db
desktop.ini

# Secrets
.env
*.json
!configs/*.json
kaggle.json

# Generated reports (keep templates, not outputs)
*.html
!docs/*.html

# Temporary
*.tmp
*.bak
*.lock
